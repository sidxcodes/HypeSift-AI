# Copy to backend/.env — every value is optional; defaults suit local development.
# All variables use the HYPESIFT_ prefix.

# --- core ---
# HYPESIFT_DATABASE_URL=sqlite:///./data/hypesift.db        # or postgresql+psycopg://user:pass@db:5432/hypesift
# HYPESIFT_STORAGE_DIR=./data/storage
HYPESIFT_SECRET_KEY=change-me-to-a-long-random-string        # signs expiring download links
# HYPESIFT_CORS_ORIGINS=http://localhost:3000
# HYPESIFT_COOKIE_SECURE=false                               # true behind HTTPS

# --- worker ---
# HYPESIFT_EMBEDDED_WORKER=true      # false = run `python -m app.worker` separately
# HYPESIFT_WORKER_CONCURRENCY=1
# HYPESIFT_JOB_MAX_ATTEMPTS=2

# --- limits / quotas ---
# HYPESIFT_MAX_UPLOAD_MB=4096
# HYPESIFT_MAX_DURATION_MINUTES=180
# HYPESIFT_MAX_CLIPS=20
# HYPESIFT_MAX_ACTIVE_JOBS_PER_USER=3
# HYPESIFT_TEMP_FILE_TTL_HOURS=24

# --- media / speech ---
# HYPESIFT_FFMPEG_BIN=ffmpeg
# HYPESIFT_FFPROBE_BIN=ffprobe
# HYPESIFT_VIDEO_ENCODER=auto        # auto | libx264 | h264_nvenc
# HYPESIFT_WHISPER_MODEL=small       # tiny | base | small | medium | large-v3
# HYPESIFT_WHISPER_DEVICE=auto       # auto | cpu | cuda

# --- optional local LLM (free) ---
# HYPESIFT_LLM_ENABLED=true
# HYPESIFT_OLLAMA_URL=http://127.0.0.1:11434
# HYPESIFT_OLLAMA_MODEL=gemma3:4b
# HYPESIFT_HTTP_USER_AGENT=HypeSiftAI/1.0 (self-hosted video tool; +https://your-site.example)
